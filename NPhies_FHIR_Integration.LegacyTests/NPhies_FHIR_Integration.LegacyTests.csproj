<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit tests for the older Application/Services stack (payment engine, adjudication rules, appeals,
    repositories, mapper). Kept separate from NPhies_FHIR_Integration.Tests (MSTest) because they need
    xunit/Moq/EF InMemory from nuget.org. Most of the code under test is scheduled for consolidation into
    the Rcm/ workflow layer; delete each test file together with the code it covers.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1998;CS8618;CS8625;xUnit1031;xUnit2013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPhies_FHIR_Integration.ApiService\NPhies_FHIR_Integration.ApiService.csproj" />
  </ItemGroup>

</Project>
