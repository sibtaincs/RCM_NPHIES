{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "NPhies_FHIR_Integration": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "NPhiesIssuer",
    "Audience": "NPhiesAudience",
    "ExpirationMinutes": 60
  },
  "AppSettings": {
    "EnableSwagger": true,
    "EnableHttpsRedirection": true,
    "LogSensitiveData": false,
    "ConnectionStringType": "SqlServer"
  },
  "Nphies": {
    "Environment": "Sandbox",
    "SandboxBaseUrl": "https://hsb.nphies.sa/",
    "ProductionBaseUrl": "https://hsb.nphies.sa/",
    "ProcessMessagePath": "$process-message",
    "Timeout": 60,
    "RetryCount": 3,
    "RetryDelaySeconds": 2,
    "EnableDetailedLogging": false,
    "EnableMessageAudit": true,
    "MaxMessageSizeBytes": 10485760,
    "BatchMaxClaims": 200,
    "PollMaxCount": 100,
    "Sender": {
      "ProviderLicense": "",
      "ProviderBaseUrl": "http://provider.com",
      "ProviderName": ""
    },
    "Certificate": {
      "Source": "None",
      "Thumbprint": "",
      "StoreName": "My",
      "StoreLocation": "CurrentUser",
      "PfxPath": "",
      "PfxPassword": ""
    },
    "Polling": {
      "IntervalSeconds": 5,
      "MaxDurationMinutes": 10,
      "ExponentialBackoff": true,
      "MaxRetries": 20,
      "InitialBackoffSeconds": 2,
      "MaxBackoffSeconds": 60
    }
  }
}
