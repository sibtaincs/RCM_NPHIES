{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "NPhies_FHIR_Integration.Infrastructure.Seeding": "Debug",
      "NPhies_FHIR_Integration.Application.Services": "Debug"
    }
  },
  "Nphies": {
    "Environment": "Sandbox",
    "EnableDetailedLogging": true,
    "Sandbox": {
      "Enabled": false,
      "SeedActivity": true
    }
  }
}
